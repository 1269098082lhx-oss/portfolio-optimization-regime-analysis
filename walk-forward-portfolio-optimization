    "\n",
    "\n",
    "plt.xlabel(\n",
    "    \"Annualized Volatility\"\n",
    ")\n",
    "\n",
    "plt.ylabel(\n",
    "    \"Expected Annual Return\"\n",
    ")\n",
    "\n",
    "plt.title(\n",

    "\n",
    "plt.legend()\n",
    "\n",
    "plt.grid(alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "\n",
    "plt.show()\n",
    "\n",
    "results = pd.DataFrame({\n",
    "\n",
    "    \"Unconstrained Max Sharpe\":\n",
